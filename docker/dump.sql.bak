--
-- Name: shopping_list_members Allow adding members to a list they own; Type: POLICY; Schema: public; Owner: supabase_admin
--

CREATE POLICY "Allow adding members to a list they own" ON public.shopping_list_members FOR INSERT WITH CHECK (true);


--
-- Name: shopping_list_items Allow members and owners to read items; Type: POLICY; Schema: public; Owner: supabase_admin
--

CREATE POLICY "Allow members and owners to read items" ON public.shopping_list_items FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.shopping_lists
  WHERE ((shopping_lists.id = shopping_list_items.shopping_list) AND ((shopping_lists.owner_id = auth.uid()) OR (EXISTS ( SELECT 1
           FROM public.shopping_list_members
          WHERE ((shopping_list_members.shopping_list_id = shopping_lists.id) AND (shopping_list_members.user_id = auth.uid())))))))));


--
-- Name: shopping_lists Allow members to update shopping lists; Type: POLICY; Schema: public; Owner: supabase_admin
--

CREATE POLICY "Allow members to update shopping lists" ON public.shopping_lists FOR UPDATE USING (((EXISTS ( SELECT 1
   FROM public.shopping_list_members
  WHERE ((shopping_list_members.shopping_list_id = shopping_lists.id) AND (shopping_list_members.user_id = auth.uid())))) OR (auth.uid() = owner_id)));


--
-- Name: shopping_list_items Allow owners and members to insert items; Type: POLICY; Schema: public; Owner: supabase_admin
--

CREATE POLICY "Allow owners and members to insert items" ON public.shopping_list_items FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.shopping_lists
  WHERE ((shopping_lists.id = shopping_list_items.shopping_list) AND ((shopping_lists.owner_id = auth.uid()) OR (EXISTS ( SELECT 1
           FROM public.shopping_list_members
          WHERE ((shopping_list_members.shopping_list_id = shopping_lists.id) AND (shopping_list_members.user_id = auth.uid())))))))));


--
-- Name: shopping_lists Allow users to create shopping lists they own; Type: POLICY; Schema: public; Owner: supabase_admin
--

CREATE POLICY "Allow users to create shopping lists they own" ON public.shopping_lists FOR INSERT WITH CHECK ((owner_id = auth.uid()));


--
-- Name: shopping_list_members Allow users to see their memberships; Type: POLICY; Schema: public; Owner: supabase_admin
--

CREATE POLICY "Allow users to see their memberships" ON public.shopping_list_members FOR SELECT TO authenticated USING (true);


--
-- Name: shopping_list_members Enable delete for users based on user_id; Type: POLICY; Schema: public; Owner: supabase_admin
--

